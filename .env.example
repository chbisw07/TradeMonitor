# TradeMonitor environment placeholders.
# Copy to .env and provide local values. Never commit .env or credentials.

TRADEMONITOR_ENV=development
TM_DATABASE_PATH=data/trademonitor.db

# Optional Google Sheets input adapter
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_SHEET_NAME=Top Picks
GOOGLE_SHEET_HEADER_ROW=1
GOOGLE_SOURCE_NAME=GOOGLE_TOP_PICKS
GOOGLE_TOP_PICKS_DEFAULT_SETUP=TOP_PICK
GOOGLE_TOP_PICKS_DEFAULT_TRADE_TYPE=DAY
GOOGLE_TOP_PICKS_DEFAULT_INSTRUMENT_TYPE=OPTION
GOOGLE_FEEDER_STATE_FILE=data/google_top_picks_state.json

# TM4/TGT3 SEMI_AUTO control (safe defaults)
TM_EXECUTION_MODE=PAPER
TM_ALLOW_REAL_BROKER_WRITES=false
TM_SEMI_AUTO_APPROVAL_TTL_SECONDS=60

# Optional Zerodha Kite Connect adapter
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
